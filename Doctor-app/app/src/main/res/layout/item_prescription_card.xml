<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/ink_200"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRxDiagnosis"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/ink_900"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Acute pharyngitis" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditRx"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Edit"
                android:textColor="@color/brand_700"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRxMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink_400"
            android:textSize="11sp"
            tools:text="03 Sep 2026 · Dr. A. Verma" />

        <TextView
            android:id="@+id/tvRxMeds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/ink_700"
            android:textSize="13sp"
            tools:text="• Azithromycin 500 mg — 1-0-0 · After food · 3 days" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
