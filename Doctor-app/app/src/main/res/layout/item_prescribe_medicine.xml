<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/ink_200"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMedName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/ink_900"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Azithromycin 500 mg" />

            <TextView
                android:id="@+id/btnRemove"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="×"
                android:textColor="@color/ink_400"
                android:textSize="22sp"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView style="@style/Text.SectionLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Frequency" />
                <EditText
                    android:id="@+id/etFrequency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_panel_muted"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp"
                    android:inputType="text"
                    android:textColor="@color/ink_900"
                    android:textSize="14sp"
                    tools:text="1-0-1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView style="@style/Text.SectionLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="When / food" />
                <AutoCompleteTextView
                    android:id="@+id/etTiming"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_panel_muted"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp"
                    android:inputType="text"
                    android:textColor="@color/ink_900"
                    android:textSize="14sp"
                    tools:text="After food" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView style="@style/Text.SectionLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Duration" />
                <EditText
                    android:id="@+id/etDuration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_panel_muted"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp"
                    android:inputType="text"
                    android:textColor="@color/ink_900"
                    android:textSize="14sp"
                    tools:text="5 days" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
